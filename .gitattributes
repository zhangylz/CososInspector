* text=auto

# Force the following filetypes to have unix eols, so Windows does not break them
*.vue              text eol=lf
*.js               text eol=lf
*.cjs              text eol=lf
*.ts               text eol=lf
*.tsx              text eol=lf
*.json             text eol=lf
*.css              text eol=lf
*.less             text eol=lf
*.scss             text eol=lf
*.html             text eol=lf
*.md               text eol=lf
*.meta             text eol=lf
*.csv              text eol=lf


# These files are binary and should be left untouched


# (binary is a macro for -text -diff)
*.png binary
*.jpg binary
*.mp3 binary
*.mp4 binary